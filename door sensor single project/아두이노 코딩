#define BLYNK_TEMPLATE_ID "여기에_템플릿_ID_입력"
#define BLYNK_TEMPLATE_NAME "여기에_템플릿_이름_입력"
#define BLYNK_AUTH_TOKEN "여기에_토큰_입력"

#include <WiFi.h>
#include <WiFiClient.h>
#include <BlynkSimpleEsp32.h>

char ssid[] = "집_와이파이_이름";
char pass[] = "집_와이파이_비밀번호";

const int sensorPin = 4;
const int buzzerPin = 5;

unsigned long doorOpenStartTime = 0;
unsigned long lastBeepTime = 0;
bool isDoorOpen = false;
bool openBeepPlayed = false;
bool buzzerState = false;
int previousSensorState = -1; 

const unsigned long maxOpenTime = 10000; 
const unsigned long beepInterval = 300;  

void setup() {
  pinMode(sensorPin, INPUT_PULLUP); 
  pinMode(buzzerPin, OUTPUT);
  digitalWrite(buzzerPin, LOW); 
  
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
}

void loop() {
  Blynk.run(); 
  
  int sensorState = digitalRead(sensorPin);
  unsigned long currentMillis = millis();

    if (sensorState != previousSensorState) {
    if (sensorState == HIGH) {
      Blynk.virtualWrite(V0, 1); // 스마트폰으로 '문 열림(1)' 신호 전송
    } else {
      Blynk.virtualWrite(V0, 0); // 스마트폰으로 '문 닫힘(0)' 신호 전송
    }
    previousSensorState = sensorState;
  }

  if (sensorState == HIGH) { 
    if (!isDoorOpen) {
      isDoorOpen = true;
      doorOpenStartTime = currentMillis; 
    }

    if (!openBeepPlayed) {
      digitalWrite(buzzerPin, HIGH);
      delay(200); 
      digitalWrite(buzzerPin, LOW);
      openBeepPlayed = true;
    }

    if (currentMillis - doorOpenStartTime >= maxOpenTime) {
      if (currentMillis - lastBeepTime >= beepInterval) {
        lastBeepTime = currentMillis;
        buzzerState = !buzzerState; 
        digitalWrite(buzzerPin, buzzerState ? HIGH : LOW);
      }
    }
  } 
  else { 
    isDoorOpen = false;
    openBeepPlayed = false;       
    digitalWrite(buzzerPin, LOW); 
  }
}
